<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ profile.name }}{% endblock %}</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <div class="nav-inner">
      <div class="nav-logo"><a href="index.html">{{ profile.name }}</a></div>

      <ul class="nav-links">
        <li><a href="index.html"    {% if active == 'home'     %}class="active"{% endif %}>Home</a></li>
        <li><a href="about.html"    {% if active == 'about'    %}class="active"{% endif %}>About</a></li>
        <li><a href="research.html" {% if active == 'research' %}class="active"{% endif %}>Research</a></li>
        <li><a href="papers.html"   {% if active == 'papers'   %}class="active"{% endif %}>Publications</a></li>
      </ul>

      <div class="nav-controls">
        <button class="theme-btn" aria-label="Toggle theme">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <button class="menu-btn" aria-expanded="false">Menu</button>
      </div>
    </div>

    <nav class="mobile-nav">
      <a href="index.html"    {% if active == 'home'     %}class="active"{% endif %}>Home</a>
      <a href="about.html"    {% if active == 'about'    %}class="active"{% endif %}>About</a>
      <a href="research.html" {% if active == 'research' %}class="active"{% endif %}>Research</a>
      <a href="papers.html"   {% if active == 'papers'   %}class="active"{% endif %}>Publications</a>
    </nav>
  </header>

  <main>
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    © {{ profile.name }} — built with Jinja2
  </footer>

  <script src="theme.js"></script>
</body>
</html>