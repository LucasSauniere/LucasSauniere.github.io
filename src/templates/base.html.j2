<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#05060c">
  <title>{% block title %}{{ profile.name }}{% endblock %}</title>
  <meta name="description"
        content="{{ profile.name }} — {{ profile.title }}, {{ profile.affiliation_full }}.">

  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>

  <link rel="stylesheet" href="static/css/style.css">

  <!-- GSAP + ScrollTrigger (loaded globally) -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>

  <!-- Three.js import map (used by Act 2/3 modules) -->
  <script type="importmap">
  {
    "imports": {
      "three":          "https://unpkg.com/three@0.160.0/build/three.module.js",
      "three/addons/":  "https://unpkg.com/three@0.160.0/examples/jsm/"
    }
  }
  </script>

  <script src="static/js/theme.js" defer></script>
</head>
<body class="{% block body_class %}{% endblock %}">

  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="nav-inner">
      <div class="nav-logo"><a href="index.html">{{ profile.name }}</a></div>
      <nav aria-label="Primary">
        <ul class="nav-links">
          <li><a href="index.html"    class="{% if active=='home'     %}active{% endif %}">Home</a></li>
          <li><a href="about.html"    class="{% if active=='about'    %}active{% endif %}">About</a></li>
          <li><a href="research.html" class="{% if active=='research' %}active{% endif %}">Research</a></li>
          <li><a href="papers.html"   class="{% if active=='papers'   %}active{% endif %}">Papers</a></li>
        </ul>
      </nav>
      <div class="nav-controls">
        <button id="themeBtn" class="theme-btn" aria-label="Toggle colour theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"/>
          </svg>
        </button>
        <button id="menuBtn" class="menu-btn" aria-label="Menu" aria-expanded="false">Menu</button>
      </div>
    </div>
    <div id="mobileNav" class="mobile-nav" role="menu">
      <a href="index.html"    class="{% if active=='home'     %}active{% endif %}" role="menuitem">Home</a>
      <a href="about.html"    class="{% if active=='about'    %}active{% endif %}" role="menuitem">About</a>
      <a href="research.html" class="{% if active=='research' %}active{% endif %}" role="menuitem">Research</a>
      <a href="papers.html"   class="{% if active=='papers'   %}active{% endif %}" role="menuitem">Papers</a>
    </div>
  </header>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <p>© {{ profile.name }} — built with GSAP &amp; Three.js</p>
  </footer>

  {% block scripts %}{% endblock %}
</body>
</html>