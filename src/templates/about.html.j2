{% extends "base.html.j2" %}
{% set active = 'about' %}
{% block title %}About — {{ profile.name }}{% endblock %}

{% block content %}
<h1 class="page-title">{{ profile.name }}</h1>
<p>{{ profile.bio_short }}</p>

<h2>Awards</h2>
<ul>
  {% for a in awards %}
    <li><strong>{{ a.year }} — {{ a.title }}</strong>.
        {{ a.contribution }}</li>
  {% endfor %}
</ul>

<h2>Software</h2>
<ul>
  {% for s in software %}
    <li><a href="{{ s.url }}">{{ s.name }}</a> — {{ s.purpose }}</li>
  {% endfor %}
</ul>

<p><a href="cv/LucasSauniere_CV.pdf">Download CV (PDF)</a></p>
{% endblock %}
