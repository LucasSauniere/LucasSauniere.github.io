{% extends "base.html.j2" %}
{% block title %}{{ profile.name }} — {{ profile.title }}{% endblock %}
{% block body_class %}page-landing{% endblock %}

{% block content %}

<section class="landing-hero">
  <h1>{{ profile.name }}</h1>
  <p class="role">{{ profile.title }}</p>
  <p class="institute">
    <a href="{{ profile.affiliation_url }}" target="_blank" rel="noopener">{{ profile.affiliation_full }}</a>
    · {{ profile.location }}
  </p>

  <p class="landing-bio">{{ profile.bio_short }}</p>

  <div class="landing-actions">
    <a class="btn primary" href="phd.html">Discover my PhD →</a>
    <a class="btn" href="cv/LucasSauniere_CV.pdf">Download CV</a>
  </div>

  <ul class="landing-socials">
    <li><a href="{{ profile.links.github }}"   target="_blank" rel="noopener">GitHub</a></li>
    <li><a href="{{ profile.links.scholar }}"  target="_blank" rel="noopener">Scholar</a></li>
    <li><a href="{{ profile.links.orcid }}"    target="_blank" rel="noopener">ORCID</a></li>
    <li><a href="{{ profile.links.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>
    <li><a href="mailto:{{ profile.email }}">Email</a></li>
  </ul>
</section>

<hr class="divider">

<section class="card-grid" aria-label="Explore">
  <a class="nav-card feature" href="phd.html">
    <span class="nav-card-kicker">Scrollytelling</span>
    <h2>My PhD, act by act</h2>
    <p>
      Follow Euclid from launch to its survey of the dark Universe, and the
      deep-learning pipeline I built to model the telescope's point spread
      function — diffusion denoising, an Inception regressor, and the on-sky
      focus campaign.
    </p>
    <span class="nav-card-go">Enter the story →</span>
  </a>

  <a class="nav-card" href="research.html">
    <h2>Research</h2>
    <p>{{ profile.research_interests[0] }}, and more.</p>
    <span class="nav-card-go">Topics →</span>
  </a>

  <a class="nav-card" href="papers.html">
    <h2>Papers</h2>
    <p>Journal articles, conference papers, and talks.</p>
    <span class="nav-card-go">Publications →</span>
  </a>

  <a class="nav-card" href="about.html">
    <h2>About</h2>
    <p>Background, education, experience, and what I'm looking for next.</p>
    <span class="nav-card-go">More about me →</span>
  </a>
</section>

{% endblock %}
