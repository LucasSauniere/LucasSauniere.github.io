{% extends "base.html.j2" %}
{% block title %}Papers — Lucas Saunière{% endblock %}
{% block content %}
<h1 class="page-title">Papers</h1>

<!-- Journal Articles -->
<h2 class="papers-section-heading">Journal Articles</h2>
<ul class="papers-list">
  {% for p in publications if p.type in ["article", "misc"] %}
  <li class="paper">
    <p class="paper-title">{{ p.title }}</p>
    <p class="paper-authors">{{ p.authors | safe }}</p>
    <p class="paper-venue">{{ p.venue }} ({{ p.year }})</p>
    <div class="paper-links">
      {% if p.doi %}
        <a class="paper-link" href="https://doi.org/{{ p.doi }}" target="_blank" rel="noopener">DOI</a>
      {% elif p.url %}
        <a class="paper-link" href="{{ p.url }}" target="_blank" rel="noopener">Link</a>
      {% else %}
        <span class="paper-link" style="border:none;color:var(--text-faint)">Preprint coming soon</span>
      {% endif %}
    </div>
  </li>
  {% endfor %}
</ul>

<!-- Conference Papers -->
<h2 class="papers-section-heading">Conference Papers</h2>
<ul class="papers-list">
  {% for p in publications if p.type == "inproceedings" %}
  <li class="paper">
    <p class="paper-title">{{ p.title }}</p>
    <p class="paper-authors">{{ p.authors | safe }}</p>
    <p class="paper-venue">{{ p.venue }} ({{ p.year }})</p>
    <div class="paper-links">
      {% if p.doi %}
        <a class="paper-link" href="https://doi.org/{{ p.doi }}" target="_blank" rel="noopener">DOI</a>
      {% endif %}
      {% if p.url %}
        <a class="paper-link" href="{{ p.url }}" target="_blank" rel="noopener">Link</a>
      {% endif %}
    </div>
  </li>
  {% endfor %}
</ul>

<!-- Conferences & Talks -->
<h2 class="papers-section-heading">Conferences &amp; Talks</h2>
<ul class="papers-list">
  {% for t in talks %}
  <li class="paper">
    <p class="paper-title">{{ t.title }}</p>
    <p class="paper-authors">{{ t.authors | safe }}</p>
    <p class="paper-venue">{{ t.venue }}</p>
  </li>
  {% endfor %}
</ul>
{% endblock %}